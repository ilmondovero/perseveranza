{
  "description": "Dormant hooks of the perseveranza loop, active only when .omc-loop/state.json exists in the project: Stop drives the phases, SessionStart tells a new session about a loop it does not own",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/shell/stop.mjs\"",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/shell/session-start.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
