{
  "description": "Dormant Stop hook of the perseveranza loop: active only when .omc-loop/state.json exists in the project",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/shell/stop.mjs\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
